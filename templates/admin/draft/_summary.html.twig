{% import '@SyliusAdmin/shared/helper/money.html.twig' as money %}

{% set currency = order.currencyCode %}
{% set items_subtotal = order.items|reduce((carry, item) => carry + item.unitPrice * item.quantity, 0) %}
{% set promotions = sylius_aggregate_adjustments(order.getAdjustmentsRecursively(constant('Sylius\\Component\\Core\\Model\\AdjustmentInterface::ORDER_UNIT_PROMOTION_ADJUSTMENT')))
    |merge(sylius_aggregate_adjustments(order.getAdjustmentsRecursively(constant('Sylius\\Component\\Core\\Model\\AdjustmentInterface::ORDER_ITEM_PROMOTION_ADJUSTMENT'))))
    |merge(sylius_aggregate_adjustments(order.getAdjustmentsRecursively(constant('Sylius\\Component\\Core\\Model\\AdjustmentInterface::ORDER_PROMOTION_ADJUSTMENT')))) %}

<div class="card mb-3" data-test-draft-summary>
    <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.customer'|trans }}</h3></div>
    <div class="card-body">
        <div><strong>{{ order.customer.fullName }}</strong></div>
        <div class="text-secondary" data-test-draft-customer-email>{{ order.customer.email }}</div>
        <div class="mt-1">
            {% if order.customer.user is not null %}
                <span class="badge bg-green-lt">{{ 'tmonier_admin_order.ui.has_account'|trans }}</span>
            {% else %}
                <span class="badge bg-secondary-lt">{{ 'tmonier_admin_order.ui.guest'|trans }}</span>
            {% endif %}
            {% if order.customer.id is not null %}
                <a href="{{ path('sylius_admin_customer_show', {'id': order.customer.id}) }}" class="ms-1">{{ 'sylius.ui.show'|trans }}</a>
            {% endif %}
        </div>
        <div class="mt-3 text-secondary">
            {% include '@SyliusAdmin/shared/grid/field/channel.html.twig' with { data: order.channel } %}
            &middot; {{ order.localeCode|sylius_locale_name }} &middot; {{ currency }}
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.summary'|trans }}</h3></div>
    <table class="table table-sm table-borderless card-table">
        <tbody>
            <tr>
                <td>{{ 'sylius.ui.items_total'|trans }}</td>
                <td class="text-end" data-test-draft-items-subtotal>{{ money.format(items_subtotal, currency) }}</td>
            </tr>
            {% for label, amount in promotions %}
                <tr class="text-success" data-test-draft-promotion="{{ label }}">
                    <td class="ps-4">{{ label }}</td>
                    <td class="text-end">{{ money.format(amount, currency) }}</td>
                </tr>
            {% endfor %}
            {% if order.promotionCoupon is not null %}
                <tr class="text-secondary">
                    <td class="ps-4">{{ 'sylius.ui.coupon_code'|trans }}</td>
                    <td class="text-end" data-test-draft-coupon>{{ order.promotionCoupon.code }}</td>
                </tr>
            {% endif %}
            <tr>
                <td>{{ 'sylius.ui.shipping_total'|trans }}</td>
                <td class="text-end" data-test-draft-shipping-total>{{ money.format(order.shippingTotal, currency) }}</td>
            </tr>
            <tr>
                <td>{{ 'sylius.ui.tax_total'|trans }}</td>
                <td class="text-end" data-test-draft-tax-total>{{ money.format(order.taxTotal, currency) }}</td>
            </tr>
        </tbody>
    </table>
    <div class="card-footer d-flex justify-content-between">
        <div class="h3 mb-0">{{ 'sylius.ui.order_total'|trans }}</div>
        <div class="h3 mb-0" data-test-draft-total>{{ money.format(order.total, currency) }}</div>
    </div>
    {% if ctx.manual_discount|default(null) is not null %}
        <div class="card-footer text-secondary small" data-test-draft-manual-discount>
            {{ 'tmonier_admin_order.ui.manual_discount'|trans }}: {{ money.format(ctx.manual_discount.amount, currency) }} &middot; {{ ctx.manual_discount.reason }}
        </div>
    {% endif %}
</div>
