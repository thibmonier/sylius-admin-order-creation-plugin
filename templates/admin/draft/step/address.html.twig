{% from '@SyliusAdmin/shared/helper/address.html.twig' import address %}

{% set form = ctx.form %}
{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{% if ctx.address_book is not empty %}
    <div class="card mb-3" data-test-address-book>
        <div class="card-header"><h3 class="card-title">{{ 'tmonier_admin_order.ui.address_book'|trans }}</h3></div>
        <div class="list-group list-group-flush">
            {% for book_address in ctx.address_book %}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="small">{{ address(book_address) }}</div>
                    <a class="btn btn-sm" href="{{ path('tmonier_admin_order_draft_address', {'id': order.id, 'address': book_address.id}) }}" data-test-use-address="{{ book_address.id }}">
                        {{ 'tmonier_admin_order.ui.use_address'|trans }}
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}

{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-test-address-form': ''}}) }}
<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.billing_address'|trans }}</h3></div>
    <div class="card-body">
        {{ form_errors(form) }}
        {{ form_widget(form.billingAddress) }}
        {{ form_row(form.differentShippingAddress) }}
    </div>
</div>
<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.shipping_address'|trans }}</h3></div>
    <div class="card-body">
        <div class="form-hint mb-3">{{ 'tmonier_admin_order.ui.shipping_address_help'|trans }}</div>
        {{ form_widget(form.shippingAddress) }}
    </div>
</div>
<div class="d-flex justify-content-between">
    <a class="btn" href="{{ path('tmonier_admin_order_draft_items', {'id': order.id}) }}">
        {{ ux_icon('tabler:arrow-left', {'class': 'icon'}) }}
        {{ 'tmonier_admin_order.ui.step.items'|trans }}
    </a>
    <button type="submit" class="btn btn-primary" data-test-next-step>
        {{ 'tmonier_admin_order.ui.next_step'|trans({'%step%': 'tmonier_admin_order.ui.step.shipping_payment'|trans}) }}
        {{ ux_icon('tabler:arrow-right', {'class': 'icon ms-1'}) }}
    </button>
</div>
{{ form_end(form) }}
