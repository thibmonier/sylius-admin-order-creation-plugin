{% from '@SyliusAdmin/shared/helper/address.html.twig' import address %}

{% set form = ctx.form %}
{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{% if ctx.address_groups is not empty %}
    <form method="get" action="{{ path('tmonier_admin_order_draft_address', {'id': order.id}) }}" class="card mb-3" data-test-address-book data-test-address-picker>
        <div class="card-header">
            <h3 class="card-title" id="known-addresses-title">{{ 'tmonier_admin_order.ui.known_addresses'|trans }}</h3>
        </div>
        <div class="card-body">
            <p class="text-secondary" id="known-addresses-help">{{ 'tmonier_admin_order.ui.known_addresses_help'|trans }}</p>
            {% for group in ctx.address_groups %}
                <fieldset class="mb-3" data-test-address-group="{{ group.code }}" aria-describedby="known-addresses-help">
                    <legend class="h4">{{ group.label|trans }}</legend>
                    {% for reference, known_address in group.addresses %}
                        <div class="form-check py-2">
                            <input class="form-check-input" type="radio" name="address" id="known-address-{{ group.code }}-{{ loop.index }}" value="{{ reference }}" required data-test-use-address>
                            <label class="form-check-label" for="known-address-{{ group.code }}-{{ loop.index }}">{{ address(known_address) }}</label>
                        </div>
                    {% endfor %}
                </fieldset>
            {% endfor %}
            <button type="submit" class="btn btn-primary">{{ 'tmonier_admin_order.ui.use_selected_address'|trans }}</button>
        </div>
    </form>
    <h3 class="h4 mb-3">{{ 'tmonier_admin_order.ui.enter_address'|trans }}</h3>
{% endif %}

{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-test-address-form': ''}}) }}
<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.billing_address'|trans }}</h3></div>
    <div class="card-body">
        {{ form_errors(form) }}
        {{ form_widget(form.billingAddress) }}
        {{ form_row(form.differentShippingAddress) }}
    </div>
</div>
<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.shipping_address'|trans }}</h3></div>
    <div class="card-body">
        <div class="form-hint mb-3">{{ 'tmonier_admin_order.ui.shipping_address_help'|trans }}</div>
        {{ form_widget(form.shippingAddress) }}
    </div>
</div>
<div class="d-flex justify-content-between">
    <a class="btn" href="{{ path('tmonier_admin_order_draft_items', {'id': order.id}) }}">
        {{ ux_icon('tabler:arrow-left', {'class': 'icon'}) }}
        {{ 'tmonier_admin_order.ui.step.items'|trans }}
    </a>
    <button type="submit" class="btn btn-primary" data-test-next-step>
        {{ 'tmonier_admin_order.ui.next_step'|trans({'%step%': 'tmonier_admin_order.ui.step.shipping_payment'|trans}) }}
        {{ ux_icon('tabler:arrow-right', {'class': 'icon ms-1'}) }}
    </button>
</div>
{{ form_end(form) }}
