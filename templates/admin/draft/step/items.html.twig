{% import '@SyliusAdmin/shared/helper/money.html.twig' as money %}

{% set items_form = ctx.items_form %}
{% form_theme items_form '@SyliusAdmin/shared/form_theme.html.twig' %}
{% form_theme ctx.add_item_form '@SyliusAdmin/shared/form_theme.html.twig' %}
{% form_theme ctx.coupon_form '@SyliusAdmin/shared/form_theme.html.twig' %}
{% if ctx.discount_form is defined %}{% form_theme ctx.discount_form '@SyliusAdmin/shared/form_theme.html.twig' %}{% endif %}
{% set currency = order.currencyCode %}

<div class="card mb-3" data-test-draft-items>
    <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.items'|trans }}</h3></div>
    {% if order.items is empty %}
        <div class="card-body text-secondary" data-test-draft-no-items>{{ 'tmonier_admin_order.ui.no_items'|trans }}</div>
        {{ form_start(items_form) }}{{ form_end(items_form) }}
    {% else %}
        {{ form_start(items_form, {attr: {id: 'tmonier-admin-order-items', novalidate: 'novalidate'}}) }}
        {% if not items_form.vars.valid %}<div class="card-body pb-0">{{ form_errors(items_form) }}</div>{% endif %}
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'sylius.ui.item'|trans }}</th>
                        <th class="text-end">{{ 'sylius.ui.unit_price'|trans }}</th>
                        <th>{{ 'sylius.ui.quantity'|trans }}</th>
                        {% if ctx.price_override_allowed %}<th>{{ 'tmonier_admin_order.form.custom_unit_price'|trans }}</th>{% endif %}
                        {% if not ctx.price_override_allowed and order.items|filter(i => i.immutable)|length > 0 %}<th>{{ 'tmonier_admin_order.ui.custom_price'|trans }}</th>{% endif %}
                        <th class="text-end">{{ 'sylius.ui.total'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in order.items %}
                        {% set item_form = items_form['item_' ~ item.id] %}
                        <tr data-test-draft-item="{{ item.variant.code }}">
                            <td>
                                <div><strong>{{ item.product.name }}</strong></div>
                                <div class="text-secondary small">{{ item.variant.name ?: '' }} {{ item.variant.code }}</div>
                                {% if item.immutable %}
                                    <span class="badge bg-orange-lt" data-test-custom-price>{{ 'tmonier_admin_order.ui.custom_price'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap" data-test-draft-item-unit-price>
                                {% if item.immutable and item.originalUnitPrice is not null and item.originalUnitPrice != item.unitPrice %}
                                    <del class="text-secondary">{{ money.format(item.originalUnitPrice, currency) }}</del><br>
                                {% endif %}
                                {{ money.format(item.unitPrice, currency) }}
                            </td>
                            <td style="width: 7rem">
                                {{ form_widget(item_form.quantity) }}
                                {{ form_errors(item_form.quantity) }}
                            </td>
                            {% if item_form.unitPrice is defined %}
                                <td style="width: 10rem">
                                    {{ form_widget(item_form.unitPrice, {attr: {placeholder: money.format(item.unitPrice, currency)}}) }}
                                    {{ form_errors(item_form.unitPrice) }}
                                </td>
                            {% elseif ctx.price_override_allowed %}
                                <td></td>
                            {% endif %}
                            {% if item_form.resetPrice is defined %}
                                <td class="text-nowrap">{{ form_widget(item_form.resetPrice) }}</td>
                            {% endif %}
                            <td class="text-end text-nowrap" data-test-draft-item-total>{{ money.format(item.total, currency) }}</td>
                            <td class="text-end">
                                <button type="submit" form="tmonier-admin-order-remove-{{ item.id }}" class="btn btn-icon btn-ghost-danger" title="{{ 'sylius.ui.delete'|trans }}" data-test-remove-item="{{ item.variant.code }}">
                                    {{ ux_icon('tabler:trash', {'class': 'icon'}) }}
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <div class="form-hint">{{ 'tmonier_admin_order.ui.items_help'|trans }}</div>
            <button type="submit" class="btn" data-test-update-items>
                {{ ux_icon('tabler:refresh', {'class': 'icon'}) }}
                {{ 'tmonier_admin_order.ui.update_items'|trans }}
            </button>
        </div>
        {{ form_end(items_form) }}

        {% for item in order.items %}
            <form id="tmonier-admin-order-remove-{{ item.id }}" action="{{ path('tmonier_admin_order_draft_item_remove', {'id': order.id, 'itemId': item.id}) }}" method="post" class="d-none">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('tmonier_admin_order_remove_item_' ~ item.id) }}">
            </form>
        {% endfor %}
    {% endif %}
</div>

<div class="card mb-3" data-test-add-item>
    <div class="card-header"><h3 class="card-title">{{ 'tmonier_admin_order.ui.add_product'|trans }}</h3></div>
    <div class="card-body">
        {{ form_start(ctx.add_item_form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(ctx.add_item_form) }}
        <div class="row align-items-end">
            <div class="col-md-8">{{ form_row(ctx.add_item_form.variant) }}</div>
            <div class="col-md-2">{{ form_row(ctx.add_item_form.quantity) }}</div>
            <div class="col-md-2 mb-3">
                <button type="submit" class="btn btn-primary w-100" data-test-add-item-button>
                    {{ ux_icon('tabler:plus', {'class': 'icon'}) }}
                    {{ 'tmonier_admin_order.ui.add'|trans }}
                </button>
            </div>
        </div>
        {{ form_end(ctx.add_item_form) }}
    </div>
</div>

<div class="row row-cards mb-3">
    <div class="col-md-6">
        <div class="card h-100" data-test-coupon>
            <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.coupon'|trans }}</h3></div>
            <div class="card-body">
                {{ form_start(ctx.coupon_form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_errors(ctx.coupon_form) }}
                {{ form_row(ctx.coupon_form.code) }}
                <button type="submit" class="btn" data-test-apply-coupon>{{ 'tmonier_admin_order.ui.apply_coupon'|trans }}</button>
                {{ form_end(ctx.coupon_form) }}
            </div>
        </div>
    </div>
    {% if ctx.discount_form is defined and ctx.discount_form is not null %}
        <div class="col-md-6">
            <div class="card h-100" data-test-manual-discount>
                <div class="card-header"><h3 class="card-title">{{ 'tmonier_admin_order.ui.manual_discount'|trans }}</h3></div>
                <div class="card-body">
                    {{ form_start(ctx.discount_form, {attr: {novalidate: 'novalidate'}}) }}
                    {{ form_errors(ctx.discount_form) }}
                    {% if ctx.manual_discount_allowed %}
                        {{ form_row(ctx.discount_form.amount) }}
                        {{ form_row(ctx.discount_form.reason) }}
                        <button type="submit" class="btn" data-test-apply-discount>{{ 'tmonier_admin_order.ui.apply_discount'|trans }}</button>
                    {% else %}
                        <div class="form-hint mb-2">{{ 'tmonier_admin_order.ui.discount_removal_only'|trans }}</div>
                        {% do ctx.discount_form.amount.setRendered %}
                        {% do ctx.discount_form.reason.setRendered %}
                        <button type="submit" class="btn btn-outline-danger" data-test-remove-discount>{{ 'tmonier_admin_order.ui.remove_discount'|trans }}</button>
                    {% endif %}
                    {{ form_end(ctx.discount_form) }}
                </div>
            </div>
        </div>
    {% endif %}
</div>

<div class="d-flex justify-content-end">
    {% if order.items is not empty %}
        <a class="btn btn-primary" href="{{ path('tmonier_admin_order_draft_address', {'id': order.id}) }}" data-test-next-step>
            {{ 'tmonier_admin_order.ui.next_step'|trans({'%step%': 'tmonier_admin_order.ui.step.address'|trans}) }}
            {{ ux_icon('tabler:arrow-right', {'class': 'icon ms-1'}) }}
        </a>
    {% endif %}
</div>
