{% set form = ctx.form %}

{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-test-shipping-payment-form': ''}}) }}
<div class="card mb-3">
    <div class="card-body">
        {{ form_errors(form) }}
        {% for child in form %}
            {% if child.vars.name != '_token' %}
                <div class="mb-4" data-test-choice="{{ child.vars.name }}">{{ form_row(child) }}</div>
            {% endif %}
        {% endfor %}
    </div>
</div>
<div class="d-flex justify-content-between">
    <a class="btn" href="{{ path('tmonier_admin_order_draft_address', {'id': order.id}) }}">
        {{ ux_icon('tabler:arrow-left', {'class': 'icon'}) }}
        {{ 'tmonier_admin_order.ui.step.address'|trans }}
    </a>
    <button type="submit" class="btn btn-primary" data-test-next-step>
        {{ 'tmonier_admin_order.ui.next_step'|trans({'%step%': 'tmonier_admin_order.ui.step.summary'|trans}) }}
        {{ ux_icon('tabler:arrow-right', {'class': 'icon ms-1'}) }}
    </button>
</div>
{{ form_end(form) }}
