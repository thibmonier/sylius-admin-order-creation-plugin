{% set form = hookable_metadata.context.form %}
{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-test-start-form': ''}}) }}
<div class="row row-cards">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title">{{ 'tmonier_admin_order.ui.channel_and_language'|trans }}</h3></div>
            <div class="card-body">
                {{ form_row(form.channel) }}
                {{ form_row(form.locale) }}
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h3 class="card-title">{{ 'sylius.ui.customer'|trans }}</h3></div>
            <div class="card-body">
                {{ form_errors(form) }}
                {{ form_row(form.customer) }}
                <div class="hr-text">{{ 'tmonier_admin_order.ui.or_new_customer'|trans }}</div>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.email) }}</div>
                    <div class="col-md-6">{{ form_row(form.phoneNumber) }}</div>
                    <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                    <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                </div>
                <div class="form-hint">{{ 'tmonier_admin_order.ui.new_customer_help'|trans }}</div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary" data-test-start-order>
                    {{ ux_icon('tabler:arrow-right', {'class': 'icon'}) }}
                    {{ 'tmonier_admin_order.ui.start'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
